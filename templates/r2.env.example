# Cloudflare R2 for attach originals (librarian host)
# Copy to /etc/centricmem/r2.env (chmod 600). Do not put keys in git.

CENTRICMEM_R2_ACCOUNT_ID=
CENTRICMEM_R2_ACCESS_KEY_ID=
CENTRICMEM_R2_SECRET_ACCESS_KEY=
CENTRICMEM_R2_BUCKET=
# Optional. Default https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# CENTRICMEM_R2_ENDPOINT=
# CENTRICMEM_R2_REGION=auto
